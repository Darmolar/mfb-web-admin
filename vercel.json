{
  "rewrites": [
    {
      "source": "/api/v1/bank-admin/:path*",
      "destination": "/api/admin-proxy?path=:path*"
    },
    {
      "source": "/api/v1/admin/queue/:path*",
      "destination": "/api/admin-proxy?ns=admin&path=queue/:path*"
    },
    {
      "source": "/api/v1/:match*",
      "destination": "http://163.245.209.118:8080/api/v1/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
